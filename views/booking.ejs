<%- include('partials/header', { clinic }) %>

<main class="booking-page">
  <section class="booking-hero">
    <div class="container">
      <p class="eyebrow">Your care, your time</p>
      <h1>Book an appointment</h1>
      <p>Choose a specialty, meet your doctor, and find a time that works for you.</p>
    </div>
  </section>

  <section class="booking-section section-padding">
    <div class="container">
      <% if (confirmed) { %>
        <div class="booking-card confirmation-card">
          <div class="confirmation-icon"><i class="bi bi-check2"></i></div>
          <p class="eyebrow">Appointment request ready</p>
          <h2>Here’s your booking summary.</h2>
          <p class="confirmation-copy">Your appointment has been saved. Please keep these details for your records.</p>
          <div class="booking-summary">
            <div><span>Booking ID</span><strong>#<%= booking.id %></strong></div>
            <div><span>Specialty</span><strong><%= booking.specialty %></strong></div>
            <div><span>Doctor</span><strong><%= booking.doctor %></strong></div>
            <div><span>Date</span><strong><%= booking.date %></strong></div>
            <div><span>Time</span><strong><%= booking.time %></strong></div>
            <div><span>Patient</span><strong><%= booking.patientName %></strong></div>
            <div><span>Contact</span><strong><%= booking.phone %><br /><%= booking.email %></strong></div>
            <div><span>Status</span><strong><%= booking.status %></strong></div>
          </div>
          <a class="btn btn-primary" href="/booking">Start again</a>
          <% if (user) { %><a class="text-link ms-3" href="/my-appointments">View my appointments <i class="bi bi-arrow-right ms-1"></i></a><% } %>
        </div>
      <% } else { %>
        <div class="booking-card">
          <div class="booking-progress" aria-label="Booking progress"><span class="progress-step active" data-progress="1">1</span><i></i><span class="progress-step" data-progress="2">2</span><i></i><span class="progress-step" data-progress="3">3</span><i></i><span class="progress-step" data-progress="4">4</span></div>
          <% if (errors.length) { %><div class="alert alert-danger" role="alert"><strong>Please check the following:</strong><ul class="mb-0 mt-2"><% errors.forEach((error) => { %><li><%= error %></li><% }) %></ul></div><% } %>
          <p class="step-copy">A refundable AED 100 consultation deposit is collected securely by Stripe when you confirm.</p>
          <form method="post" action="/booking" id="bookingForm" novalidate>
            <fieldset class="booking-step active" data-step="1"><legend>What can we help with?</legend><p class="step-copy">Select a specialty to get started.</p><div class="choice-grid"><% specialties.forEach((specialty) => { %><label class="choice-card"><input type="radio" name="specialty" value="<%= specialty %>" <%= booking.specialty === specialty ? 'checked' : '' %> /><span><i class="bi <%= specialty === 'General Physician' ? 'bi-clipboard2-pulse' : specialty === 'ENT' ? 'bi-ear' : specialty === 'Dentist' ? 'bi-emoji-smile' : 'bi-heart-pulse' %>"></i><strong><%= specialty %></strong><small><%= doctorsBySpecialty[specialty] %></small></span></label><% }) %></div><button type="button" class="btn btn-primary next-step">Continue <i class="bi bi-arrow-right ms-2"></i></button></fieldset>
            <fieldset class="booking-step" data-step="2"><legend>Choose your doctor</legend><p class="step-copy">Your selected specialty’s doctor is shown below.</p><label class="form-label" for="doctor">Doctor</label><select class="form-select form-select-lg" id="doctor" name="doctor" required><option value="">Select a doctor</option><% specialties.forEach((specialty) => { %><option value="<%= doctorsBySpecialty[specialty] %>" data-specialty="<%= specialty %>" <%= booking.doctor === doctorsBySpecialty[specialty] ? 'selected' : '' %>><%= doctorsBySpecialty[specialty] %> — <%= specialty %></option><% }) %></select><div class="step-actions"><button type="button" class="btn btn-outline-secondary previous-step">Back</button><button type="button" class="btn btn-primary next-step">Continue <i class="bi bi-arrow-right ms-2"></i></button></div></fieldset>
            <fieldset class="booking-step" data-step="3"><legend>Find a time</legend><p class="step-copy">Appointments are available Monday to Saturday, from 9:00am to 9:00pm.</p><div class="row g-3"><div class="col-md-6"><label class="form-label" for="date">Date</label><input class="form-control form-control-lg" type="date" id="date" name="date" min="<%= minDate %>" value="<%= booking.date %>" required /><div class="form-text">Sundays are closed.</div></div><div class="col-md-6"><label class="form-label" for="time">Time slot</label><select class="form-select form-select-lg" id="time" name="time" required><option value="">Select a time</option><% timeSlots.forEach((slot) => { %><option value="<%= slot %>" <%= booking.time === slot ? 'selected' : '' %>><%= slot %></option><% }) %></select><div class="form-text">30-minute appointments.</div></div></div><div class="step-actions"><button type="button" class="btn btn-outline-secondary previous-step">Back</button><button type="button" class="btn btn-primary next-step">Continue <i class="bi bi-arrow-right ms-2"></i></button></div></fieldset>
            <fieldset class="booking-step" data-step="4"><legend>Tell us about you</legend><p class="step-copy">We’ll use these details for your appointment request.</p><div class="row g-3"><div class="col-12"><label class="form-label" for="patientName">Patient name</label><input class="form-control form-control-lg" type="text" id="patientName" name="patientName" value="<%= booking.patientName %>" minlength="2" maxlength="80" required /></div><div class="col-md-6"><label class="form-label" for="phone">Phone</label><input class="form-control form-control-lg" type="tel" id="phone" name="phone" value="<%= booking.phone %>" required /></div><div class="col-md-6"><label class="form-label" for="email">Email</label><input class="form-control form-control-lg" type="email" id="email" name="email" value="<%= booking.email %>" <%= user ? 'readonly' : '' %> required /></div></div><div class="step-actions"><button type="button" class="btn btn-outline-secondary previous-step">Back</button><button type="submit" class="btn btn-primary">Confirm booking <i class="bi bi-check2 ms-2"></i></button></div></fieldset>
          </form>
        </div>
      <% } %>
    </div>
  </section>
</main>

<script>
  (() => {
    const form = document.querySelector('#bookingForm');
    if (!form) return;
    const steps = [...form.querySelectorAll('.booking-step')];
    const progress = [...document.querySelectorAll('.progress-step')];
    const specialtyInputs = [...form.querySelectorAll('input[name="specialty"]')];
    const doctor = form.querySelector('#doctor');
    const date = form.querySelector('#date');
    let currentStep = 1;

    const showStep = (step) => {
      currentStep = step;
      steps.forEach((item) => item.classList.toggle('active', Number(item.dataset.step) === step));
      progress.forEach((item) => item.classList.toggle('active', Number(item.dataset.progress) <= step));
    };

    const validStep = () => {
      const step = steps[currentStep - 1];
      if (currentStep === 1 && !specialtyInputs.some((input) => input.checked)) return false;
      if (currentStep === 2 && !doctor.value) return false;
      if (currentStep === 3) {
        if (!date.value || date.value < date.min || new Date(`${date.value}T00:00:00`).getDay() === 0 || !form.querySelector('#time').value) return false;
      }
      return currentStep !== 4 && [...step.querySelectorAll('input, select')].every((field) => field.checkValidity());
    };

    specialtyInputs.forEach((input) => input.addEventListener('change', () => {
      [...doctor.options].forEach((option) => { option.hidden = option.value && option.dataset.specialty !== input.value; });
      doctor.value = '';
    }));
    form.querySelectorAll('.next-step').forEach((button) => button.addEventListener('click', () => { if (validStep()) showStep(currentStep + 1); }));
    form.querySelectorAll('.previous-step').forEach((button) => button.addEventListener('click', () => showStep(currentStep - 1)));
    form.addEventListener('submit', (event) => { if (!form.checkValidity()) { event.preventDefault(); form.reportValidity(); } });
  })();
</script>

<%- include('partials/footer', { clinic }) %>
