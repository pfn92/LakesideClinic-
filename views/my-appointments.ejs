<%- include('partials/header', { clinic }) %>

<main class="appointments-page section-padding"><div class="container"><div class="page-heading"><p class="eyebrow">Your care at a glance</p><h1>My appointments</h1><p>Welcome back, <%= user.patientName %>. Here are your latest appointment details.</p></div><% if (!appointments.length) { %><div class="empty-state"><i class="bi bi-calendar2-heart"></i><h2>No appointments yet</h2><p>When you book an appointment, it will appear here.</p><a class="btn btn-primary" href="/booking">Book an appointment</a></div><% } else { %><div class="appointments-list"><% appointments.forEach((appointment) => { %><article class="appointment-card"><div class="appointment-icon"><i class="bi bi-calendar2-check"></i></div><div class="appointment-details"><div class="d-flex flex-wrap justify-content-between gap-2"><h2><%= appointment.specialty %></h2><span class="status-badge <%= appointment.status === 'Cancelled' ? 'cancelled' : '' %>"><%= appointment.status %></span></div><p class="appointment-doctor"><%= appointment.doctor %></p><div class="appointment-meta"><span><i class="bi bi-calendar3"></i><%= appointment.appointmentDateTime.replace('T', ' ') %></span><span><i class="bi bi-person"></i><%= appointment.patientName %></span></div><% if (appointment.status !== 'Cancelled') { %><form method="post" action="/my-appointments/<%= appointment.id %>/cancel" onsubmit="return confirm('Cancel this appointment?');"><button class="btn btn-outline-danger btn-sm" type="submit">Cancel</button></form><% } %></div></article><% }) %></div><% } %></div></main>

<%- include('partials/footer', { clinic }) %>
