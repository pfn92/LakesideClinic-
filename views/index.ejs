<%- include('partials/header', { clinic }) %>

<main id="top">
  <section class="hero-section">
    <div class="container"><div class="row align-items-center g-5"><div class="col-lg-7">
      <p class="eyebrow"><i class="bi bi-heart-pulse-fill me-2"></i>Trusted family healthcare in <%= clinic.area %></p>
      <h1>Better health begins with <span>the right care.</span></h1>
      <p class="hero-copy"><%= clinic.tagline %>. Our caring medical team is here to make every visit feel simple, personal, and reassuring.</p>
      <div class="d-flex flex-wrap gap-3 align-items-center"><a class="btn btn-primary btn-lg" href="/booking">Book an appointment <i class="bi bi-arrow-up-right ms-2"></i></a><a class="text-link" href="#specialties">Explore our specialties <i class="bi bi-arrow-down ms-1"></i></a></div>
      <div class="hero-trust d-flex flex-wrap gap-4 mt-5"><span><i class="bi bi-check-circle-fill"></i> Experienced doctors</span><span><i class="bi bi-check-circle-fill"></i> Patient-first approach</span></div>
    </div><div class="col-lg-5"><div class="hero-card"><div class="hero-card-orb orb-one"></div><div class="hero-card-orb orb-two"></div><div class="hero-card-content"><span class="availability-badge"><i class="bi bi-circle-fill"></i> Open today</span><div class="doctor-illustration"><i class="bi bi-person-heart"></i></div><p class="mb-1">Your wellbeing, our priority</p><strong>Care that listens.<br />Health that lasts.</strong><div class="card-line"></div><small><i class="bi bi-clock me-2"></i>Mon–Sat, 9:00am–9:00pm</small></div></div></div></div></div>
  </section>

  <section class="section-padding specialties-section" id="specialties"><div class="container"><div class="section-heading d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3"><div><p class="eyebrow">What we care for</p><h2>Our specialties</h2></div><p class="section-intro">Comprehensive care for you and your family, all under one roof.</p></div><div class="row g-4 mt-2">
    <div class="col-md-6 col-lg-3"><article class="specialty-card"><div class="icon-box"><i class="bi bi-clipboard2-pulse"></i></div><h3>General Physician</h3><p>Everyday care, health checks, and guidance for your whole family.</p><a href="/booking" aria-label="Book a General Physician appointment"><i class="bi bi-arrow-up-right"></i></a></article></div>
    <div class="col-md-6 col-lg-3"><article class="specialty-card"><div class="icon-box"><i class="bi bi-ear"></i></div><h3>ENT</h3><p>Expert support for ear, nose, throat, and breathing concerns.</p><a href="/booking" aria-label="Book an ENT appointment"><i class="bi bi-arrow-up-right"></i></a></article></div>
    <div class="col-md-6 col-lg-3"><article class="specialty-card"><div class="icon-box"><i class="bi bi-emoji-smile"></i></div><h3>Dentist</h3><p>Comfortable, modern dental care for a healthier, brighter smile.</p><a href="/booking" aria-label="Book a Dentist appointment"><i class="bi bi-arrow-up-right"></i></a></article></div>
    <div class="col-md-6 col-lg-3"><article class="specialty-card"><div class="icon-box"><i class="bi bi-heart-pulse"></i></div><h3>Cardiologist</h3><p>Thoughtful heart care focused on prevention and long-term health.</p><a href="/booking" aria-label="Book a Cardiologist appointment"><i class="bi bi-arrow-up-right"></i></a></article></div>
  </div></div></section>

  <section class="about-section section-padding" id="about"><div class="container"><div class="row align-items-center g-5"><div class="col-lg-5"><div class="about-visual"><span class="about-number">01</span><i class="bi bi-hospital"></i><div class="about-stamp">Care<br /><strong>with<br />heart</strong></div></div></div><div class="col-lg-6 offset-lg-1"><p class="eyebrow">A healthier way forward</p><h2>Healthcare that feels a little more human.</h2><p class="lead-copy">At <%= clinic.name %>, we believe great healthcare starts with listening. From your first consultation to your ongoing care, our experienced team takes the time to understand what you need.</p><p>We combine trusted medical expertise with a warm, welcoming environment so you can feel confident at every step. Your health is personal — and your care should be too.</p><a class="text-link" href="#contact">Come and meet our team <i class="bi bi-arrow-right ms-1"></i></a></div></div></div></section>

  <section class="contact-section section-padding" id="contact"><div class="container"><div class="contact-panel"><div class="row g-5 align-items-center"><div class="col-lg-5"><p class="eyebrow">We’re here for you</p><h2>Let’s take care of your health.</h2><p>Ready to feel your best? Get in touch with our friendly reception team to arrange your visit.</p><a class="btn btn-light btn-lg mt-2" href="tel:<%= clinic.phone.replace(/\s/g, '') %>">Call us <i class="bi bi-telephone ms-2"></i></a></div><div class="col-lg-6 offset-lg-1"><div class="contact-details"><div><i class="bi bi-geo-alt"></i><div><small>Visit us</small><p><%= clinic.address %></p></div></div><div><i class="bi bi-telephone"></i><div><small>Call us</small><p><%= clinic.phone %></p></div></div><div><i class="bi bi-clock"></i><div><small>Opening hours</small><p><%= clinic.hours %><br /><span>Closed Sunday</span></p></div></div></div></div></div></div></div></section>
</main>

<%- include('partials/footer', { clinic }) %>
