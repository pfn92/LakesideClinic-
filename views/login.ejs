<%- include('partials/header', { clinic }) %>

<main class="auth-page section-padding"><div class="container"><div class="auth-card"><p class="eyebrow">Welcome back</p><h1>Log in to your account</h1><p class="auth-intro">Access your appointments and manage your care with Lakeside.</p><% if (errors.length) { %><div class="alert alert-danger"><ul class="mb-0"><% errors.forEach((error) => { %><li><%= error %></li><% }) %></ul></div><% } %><form method="post" action="/login"><div class="mb-3"><label class="form-label" for="email">Email</label><input class="form-control form-control-lg" id="email" name="email" type="email" value="<%= form.email %>" required /></div><div class="mb-4"><label class="form-label" for="password">Password</label><input class="form-control form-control-lg" id="password" name="password" type="password" required /></div><button class="btn btn-primary btn-lg w-100" type="submit">Log in</button></form><p class="auth-switch">Need an account? <a href="/register">Register</a></p></div></div></main>

<%- include('partials/footer', { clinic }) %>
