<%- include('partials/header', { clinic }) %>

<main class="booking-page reception-dashboard">
  <section class="booking-hero reception-hero">
    <div class="container">
      <div class="d-flex justify-content-between align-items-start gap-3">
        <div>
          <p class="eyebrow">Staff dashboard</p>
          <h1>Reception</h1>
          <p class="mb-0"><%= clinic.name.replace(' Clinic', '') %> Reception · London International · lisrc.ae</p>
        </div>
        <small class="text-end">by Aisha Khan</small>
      </div>
    </div>
  </section>

  <section class="booking-section section-padding">
    <div class="container">
      <% if (notice) { %>
        <div class="alert alert-<%= noticeType %>" role="status"><%= notice %></div>
      <% } %>

      <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
          <p class="eyebrow mb-1">Today · <%= today %></p>
          <h2 class="mb-0">Appointments</h2>
        </div>
        <div class="display-6 fw-bold"><%= appointmentCount %></div>
      </div>

      <% if (appointmentCount === 0) { %>
        <div class="booking-card"><p class="mb-0">There are no appointments today.</p></div>
      <% } else { %>
        <% Object.entries(appointmentsByDoctor).forEach(([doctor, doctorAppointments]) => { %>
          <section class="booking-card mb-4" aria-labelledby="doctor-<%= doctor.replace(/\W/g, '-') %>">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <h3 id="doctor-<%= doctor.replace(/\W/g, '-') %>" class="h5 mb-0"><%= doctor %></h3>
              <span class="text-muted small"><%= doctorAppointments.length %> appointment<%= doctorAppointments.length === 1 ? '' : 's' %></span>
            </div>
            <div class="table-responsive">
              <table class="table align-middle mb-0">
                <thead>
                  <tr>
                    <th scope="col">Patient</th>
                    <th scope="col">Time</th>
                    <th scope="col">Specialty</th>
                    <th scope="col">Status</th>
                    <th scope="col"><span class="visually-hidden">Actions</span></th>
                  </tr>
                </thead>
                <tbody>
                  <% doctorAppointments.forEach((appointment) => { %>
                    <tr>
                      <td><%= appointment.patientName %></td>
                      <td><%= appointment.appointmentDateTime.slice(11, 16) %></td>
                      <td><%= appointment.specialty %></td>
                      <td><span class="badge text-bg-light"><%= appointment.status %></span></td>
                      <td>
                        <div class="d-flex flex-wrap gap-2">
                          <% ['Arrived', 'Done', 'No-show'].forEach((status) => { %>
                            <form method="post" action="/reception/<%= appointment.id %>/status">
                              <input type="hidden" name="status" value="<%= status %>">
                              <button class="btn btn-outline-primary btn-sm" type="submit"><%= status %></button>
                            </form>
                          <% }) %>
                          <% if (appointment.status !== 'Done' && appointment.status !== 'No-show') { %>
                            <form method="post" action="/reception/<%= appointment.id %>/reminder">
                              <button class="btn btn-outline-secondary btn-sm" type="submit">Send reminder</button>
                            </form>
                          <% } %>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </section>
        <% }) %>
      <% } %>
    </div>
  </section>
</main>

<%- include('partials/footer', { clinic }) %>
